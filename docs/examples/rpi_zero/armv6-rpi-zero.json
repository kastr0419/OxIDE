{
  "llvm-target": "arm-unknown-none-eabi",
  "target-endian": "little",
  "target-pointer-width": "32",
  "data-layout": "e-m:e-p:32:32-i64:64-v128:64:128-n32-S64",
  "arch": "arm",
  "os": "none",
  "vendor": "unknown",
  "linker-flavor": "ld",
  "linker": "arm-none-eabi-ld",
  "pre-link-args": { "ld": ["-nostdlib"] }
}
